# Copy this file to .env and fill in real values before running the app.
# `.env` itself is gitignored; this file is the one exception to the
# `.env.*` glob (see .gitignore) so onboarding has something to copy.

# ---- Required -----------------------------------------------------------

# Postgres connection string. Railway injects this automatically when you
# attach a PostgreSQL database to the project; for local dev, point it at
# any Postgres 13+ instance.
DATABASE_URL=postgres://user:password@localhost:5432/doctracker

# Signs/verifies session JWTs. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# Envelope-encryption root key for project/environment data at rest
# (server/crypto.js). Must decode (base64) to exactly 32 bytes. Generate
# with:
#   openssl rand -base64 32
# Losing this key makes all encrypted data permanently unreadable — back it
# up somewhere other than this file.
MASTER_KEY=

# ---- Optional -------------------------------------------------------------

# Port the server listens on. Defaults to 3000.
PORT=3000

# Comma-separated list of origins allowed by CORS. Defaults to permissive
# in development; set explicitly in production.
ALLOWED_ORIGINS=http://localhost:3000

# Max size of the Postgres connection pool. Defaults to a small pool
# suitable for a single instance.
DB_POOL_MAX=10

# Enables Redis-shared rate limiting, the GET /api/workspace cache, and
# cross-instance live-update fan-out (server/cache.js, rateLimitStore.js,
# observabilityBus.js, notificationsBus.js). Omit for a single-instance
# deploy — everything degrades to per-instance in-memory behavior.
REDIS_URL=

# S3-compatible object storage for attachments, offloaded from the default
# inline-encrypted-in-JSON storage once these are all set (server/storage.js).
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=

# Comma-separated usernames/emails granted cross-organisation platform-
# operator access (server/routes/security.js). Leave unset unless you
# specifically need this.
PLATFORM_OPERATORS=

# Alert engine tuning (server/alertEngine.js) — see ALERTING.md. Defaults
# shown; only set these if you need a different sweep cadence.
ALERT_SWEEP_INTERVAL_MS=60000
ALERT_MIN_EVAL_INTERVAL_MS=30000

# Retention windows in days for audit logs, notifications, and
# observability rollups (server/retention.js). Defaults shown; audit-log
# archiving is OFF by default (0) — set it explicitly to enable.
AUDIT_LOG_RETENTION_DAYS=0
NOTIFICATIONS_RETENTION_DAYS=90
OBS_ROLLUP_RETENTION_DAYS=400
OBS_RECORD_RETENTION_DAYS=7
OBS_ROLLUP_MINUTE_RETENTION_DAYS=30

NODE_ENV=development
